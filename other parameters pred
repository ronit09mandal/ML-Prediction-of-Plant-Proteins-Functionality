#Hyperparameter tuning

#POlynomial
library(caret)

# Define the degrees of the polynomial to evaluate
degree_grid <- c(1, 2, 3, 4)  # Example grid of degrees to try

# Create a data frame to store the results
results <- data.frame(degree = integer(), RMSE = numeric(), stringsAsFactors = FALSE)

# Perform cross-validation to evaluate different degrees
for (degree in degree_grid) {
  # Fit the polynomial regression model with the current degree
  formula <- as.formula(paste("EAI ~ poly(Surface_Hydrophobicity, degree = ", degree, ") + poly(Solubility_7NH, degree = ", degree, ") + poly(U, degree = ", degree, ")", sep = ""))
  poly_model <- lm(formula, data = train_data)
  
  # Make predictions on the test set
  pred <- predict(poly_model, newdata = test_data)
  
  # Calculate RMSE
  rmse <- sqrt(mean((test_data$EAI - pred)^2))
  
  # Store the results
  results <- rbind(results, data.frame(degree = degree, RMSE = rmse))
}

# Print the results
print(results)


