library(neuralnet)
library(class)
library(readxl)
library(splines)
library(rpart)
library(gbm)
library(lightgbm)
library(xgboost)
library(glmnet)
library(lars)


# Read in data
protein_data <- read_xlsx("dataset path.xlsx")

# Split data into training and testing sets
set.seed(123)
train_idx <- createDataPartition(protein_data$EAI, p = 0.7, list = FALSE)
train_data <- protein_data[train_idx, ]
test_data <- protein_data[-train_idx, ]

# Create regression models
lm_model <- lm(EAI ~ Surface_Hydrophobicity + Solubility_7NH+U, data = train_data)
poly_model <- lm(EAI ~ poly(Surface_Hydrophobicity, degree = 3) + poly(Solubility_7NH, degree = 3)+ poly(U, degree = 3), data = train_data)
rf_model <- randomForest(EAI ~ Surface_Hydrophobicity + Solubility_7NH+U, data = train_data)
svm_model <- ksvm(EAI ~ Surface_Hydrophobicity + Solubility_7NH+U, data = train_data, type = "eps-svr", kernel = "vanilladot")
svm_model <- ksvm(EAI ~ Surface_Hydrophobicity + Solubility_7NH+U, data = train_data, type = "eps-svr", kernel = "rbfdot",
                  C = 0.1, kpar = list(sigma = 0.01))
gaussian_model <- ksvm(EAI ~ Surface_Hydrophobicity + Solubility_7NH+U, data = train_data, kernel = "rbfdot", type = "eps-svr",
                       C = 10, kpar = list(sigma = 1))
nn_model <- neuralnet(EAI ~ Surface_Hydrophobicity + Solubility_7NH+U, data = train_data, hidden = c(7,5))
spline_model <- lm(EAI ~ ns(Surface_Hydrophobicity, df = 3) + ns(Solubility_7NH, df=5)+ ns(U, df = 3), data = train_data)
knn_model <- knn(train = train_data[, c("Surface_Hydrophobicity", "Solubility_7NH", "U")], 
                 test = test_data[, c("Surface_Hydrophobicity", "Solubility_7NH", "U")], 
                 cl = train_data$EAI, 
                 k = 10)
tree_model <- rpart(EAI ~ Surface_Hydrophobicity + Solubility_7NH + U, data = train_data)
tree_model <- rpart(EAI ~ Surface_Hydrophobicity + Solubility_7NH + U, data = train_data, method = "anova", 
                    control = rpart.control(maxdepth = 6, 
                                            minsplit = 2, 
                                            minbucket = 1, 
                                            cp = 0.01))
gbm_model <- gbm(EAI ~ Surface_Hydrophobicity + Solubility_7NH + U, data = train_data, n.trees = 100, interaction.depth = 3)
gbm_model <- train(
  EAI ~ Surface_Hydrophobicity + Solubility_7NH + U,
  data = train_data,
  method = "gbm",
  trControl = trainControl(method = "cv", number = 5),
  tuneGrid = data.frame(n.trees = 50,
                        interaction.depth = 7,
                        shrinkage = 0.1,
                        n.minobsinnode = 5)
)
poisson_model <- glm(EAI ~ Surface_Hydrophobicity +Solubility_7NH + U, data = train_data, family = poisson())

lasso_model <- glmnet( x= as.matrix(train_data[, c("Surface_Hydrophobicity", "Solubility_7NH", "U")]), y = train_data$EAI, alpha = 1, lambda = 1)
loglinear_model <- glm(EAI ~ Surface_Hydrophobicity + Solubility_7NH + U, data = train_data, family = poisson(link = "log"))

# Make predictions using test set
lm_pred <- predict(lm_model, newdata = test_data)
poly_pred <- predict(poly_model, newdata = test_data)
rf_pred <- predict(rf_model, newdata = test_data)
svm_pred <- predict(svm_model, newdata = test_data)
gaussian_pred <- predict(gaussian_model, newdata = test_data)
nn_pred <- predict(nn_model, newdata = test_data)
sp_pred <- predict(spline_model, newdata = test_data)
knn_pred <- as.numeric(knn_model)
tree_pred <- predict(tree_model, newdata = test_data)
poisson_pred <- predict(poisson_model, newdata = test_data)
gbm_pred <- predict(gbm_model, newdata = test_data)
lasso_pred <- predict(lasso_model, newx = as.matrix(test_data[, c("Surface_Hydrophobicity", "Solubility_7NH", "U")]))
loglinear_pred <- predict(loglinear_model, newdata = test_data, type = "response")


# Create a data frame to store the predictions
predictions <- data.frame(lm = lm_pred, poly_pred, rf = rf_pred, svm = svm_pred, gaussian = gaussian_pred, nn = nn_pred, sp_pred, tree = tree_pred, gbm = gbm_pred, poisson = poisson_pred, lasso = lasso_pred, loglin = loglinear_pred, actual = test_data$EAI)

# Melt the data frame for plotting
library(reshape)
predictions_melted <- melt(predictions, id.vars = "actual", variable.name = "model", value.name = "predicted")


# Create a scatter plot with actual values on x-axis and predicted values on y-axis
ggplot(predictions_melted, aes(x = actual, y = predicted, color = model)) + 
  geom_point() + 
  labs(x = "Actual Solubility", y = "Predicted Solubility", color = "Model") + 
  theme_bw()


