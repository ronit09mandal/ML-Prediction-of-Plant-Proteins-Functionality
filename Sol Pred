# Load necessary libraries
library(ggplot2)
library(caret)
library(randomForest)
library(kernlab)
library(nnet)
library(neuralnet)
library(class)
library(readxl)
library(splines)
library(rpart)
library(gbm)
library(glmnet)
library(lars)
library(ggridges)


# Read in data
protein_data <- read_xlsx("dataset address link")


ggplot(data=protein_data, aes(`EAI`, `Surface_Hydrophobicity`)) +
  geom_point(aes(color=Species), cex = 3)  + theme(
    axis.title.x = element_text(color="black", size=14, face="bold"),
    axis.title.y = element_text(color="black", size=14, face="bold"), legend.title = element_text(face = "bold", size = 13), panel.background = element_rect(fill = 'white', color = 'black'),
    panel.grid.major = element_line(color = 'grey', linetype = 'solid'))+ 
  xlab("Zeta Potential [mV]") + 
  ylab("Solubility [%]")

# Split data into training and testing sets
set.seed(123)
train_idx <- createDataPartition(protein_data$Solubility_7NH, p = 0.7, list = FALSE)
train_data <- protein_data[train_idx, ]
test_data <- protein_data[-train_idx, ]

train_data$Solubility_7NH <- as.numeric(as.character(train_data$Solubility_7NH))
test_data$Solubility_7NH <- as.numeric(as.character(test_data$Solubility_7NH))

# Create regression models
lm_model <- lm(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential+U, data = train_data)
poly_model <- lm(Solubility_7NH ~ poly(Surface_Hydrophobicity, degree = 3) + poly(Zeta_Potential, degree = 3)+ poly(U, degree = 3), data = train_data)
rf_model <- randomForest(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential+U, data = train_data)
svm_model <- ksvm(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential+U, data = train_data, type = "eps-svr", kernel = "vanilladot")
svm_model <- ksvm(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential + U, data = train_data, type = "eps-svr", kernel = "rbfdot",
  C = 0.1, kpar = list(sigma = 0.01))
gaussian_model <- ksvm(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential+U, data = train_data, kernel = "rbfdot", type = "eps-svr",
                       C = 10, kpar = list(sigma = 1))
nn_model <- neuralnet(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential+U, data = train_data, hidden = c(5))
spline_model <- lm(Solubility_7NH ~ ns(Surface_Hydrophobicity, df = 4) + ns(Zeta_Potential, df = 5) + ns(U, df = 3), data = train_data)
knn_model <- knn(train = train_data[, c("Surface_Hydrophobicity", "Zeta_Potential", "U")], 
                 test = test_data[, c("Surface_Hydrophobicity", "Zeta_Potential", "U")], 
                 cl = train_data$Solubility_7NH, 
                 k = 5)
knn_model <- knn(train = train_data[, c("Surface_Hydrophobicity", "Zeta_Potential", "U")], 
                 test = test_data[, c("Surface_Hydrophobicity", "Zeta_Potential", "U")], 
                 cl = train_data$Solubility_7NH, 
                 k = 8)
tree_model <- rpart(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential + U, data = train_data)
tree_model <- rpart(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential + U, data = train_data, method = "anova", 
control = rpart.control(maxdepth = 6, 
                        minsplit = 2, 
                        minbucket = 1, 
                        cp = 0.001))
gbm_model <- gbm(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential + U, data = train_data, n.trees = 100, interaction.depth = 3)
gbm_model <- train(
  Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential + U,
  data = train_data,
  method = "gbm",
  trControl = trainControl(method = "cv", number = 5),
  tuneGrid = data.frame(n.trees = 100,
                        interaction.depth = 7,
                        shrinkage = 0.1,
                        n.minobsinnode = 5)
)
poisson_model <- glm(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential + U, data = train_data, family = poisson())
poisson_model <- glm(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential + U, data = train_data, family = poisson())
lasso_model <- glmnet( x= as.matrix(train_data[, c("Surface_Hydrophobicity", "Zeta_Potential", "U")]), y = train_data$Solubility_7NH, alpha = 1, lambda = 1)
loglinear_model <- glm(Solubility_7NH ~ Surface_Hydrophobicity + Zeta_Potential + U, data = train_data, family = poisson(link = "log"))




# Make predictions using test set
lm_pred <- predict(lm_model, newdata = test_data)
poly_pred <- predict(poly_model, newdata = test_data)
rf_pred <- predict(rf_model, newdata = test_data)
svm_pred <- predict(svm_model, newdata = test_data)
gaussian_pred <- predict(gaussian_model, newdata = test_data)
nn_pred <- predict(nn_model, newdata = test_data)
sp_pred <- predict(spline_model, newdata = test_data)
knn_pred <- predict(knn_model, newdata = test_data)
knn_pred <- as.numeric(knn_model)
tree_pred <- predict(tree_model, newdata = test_data)
poisson_pred <- predict(poisson_model, newdata = test_data)
gbm_pred <- predict(gbm_model, newdata = test_data)
lasso_pred <- predict(lasso_model, newx = as.matrix(test_data[, c("Surface_Hydrophobicity", "Zeta_Potential", "U")]))
loglinear_pred <- predict(loglinear_model, newdata = test_data, type = "response")

# Create a data frame to store the predictions
predictions <- data.frame(lm = lm_pred, poly = poly_pred, rf = rf_pred, svm = svm_pred, gaussian = gaussian_pred, nn = nn_pred, spline = sp_pred, tree = tree_pred, gbm = gbm_pred, poisson = poisson_pred, lasso = lasso_pred, loglin = loglinear_pred, actual = test_data$Solubility_7NH)

library(reshape2)
